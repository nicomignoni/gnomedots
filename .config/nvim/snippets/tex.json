{
    "texttt": {
        "prefix": "tt",
        "body": "\\texttt{$1}$0",
        "description": "typewriter font"
    },
    "textit": {
        "prefix": "it",
        "body": "\\textit{$1}$0",
        "description": "italic font"
    },
    "textbf": {
        "prefix": "bt",
        "body": "\\textbf{$1}$0",
        "description": "bold font"
    },
    "mathrm": {
        "prefix": "mr",
        "body": "\\mathrm{$1}$0",
        "description": "math roman font"
    },
    "mathbf": {
        "prefix": "mf",
        "body": "\\mathbf{$1}$0",
        "description": "math bold font"
    },
    "mathbb": {
        "prefix": "mb",
        "body": "\\mathbb{$1}$0",
        "description": "math blackboard bold font"
    },
    "mathcal": {
        "prefix": "mc",
        "body": "\\mathcal{$1}$0",
        "description": "math caligraphic font"
    },
    "mathit": {
        "prefix": "mi",
        "body": "\\mathit{$1}$0",
        "description": "math italic font"
    },
    "mathtt": {
        "prefix": "mt",
        "body": "\\mathtt{$1}$0",
        "description": "math typewriter font"
    },
    "itemize": {
	"prefix": "itemize",
	"body": "\\begin{itemize}\n\t\\item $1\n\\end{itemize}",
	"description": "the itemize block"
    },
    "enumerate": {
	"prefix": "enumerate",
	"body": "\\begin{enumerate}\n\t\\item $1\n\\end{enumerate}",
	"description": "the enumerate block"
    },
    "frame": {
	"prefix": "frame",
	"body": "\\begin{frame}{$1}\n\t$0\n\\end{frame}",
	"description": "the baeamer's frame"
    }
}
