{
    "reals": {
	"prefix": "R",
	"body": "\\mathbb{R}",
	"description": "the set of real numbers"
    },
    "nonnegative reals": {
	"prefix": "RR",
	"body": "\\mathbb{R}_{\\geq 0}",
	"description": "the set of nonnegative real numbers"
    },
    "positive reals": {
	"prefix": "RRR",
	"body": "\\mathbb{R}_{> 0}",
	"description": "the set of positive real numbers"
    },
    "texttt": {
	"prefix": "tt",
	"body": "\\texttt{$1}$0",
	"description": "typewriter font"
    },
    "textit": {
	"prefix": "it",
	"body": "\\textit{$1}$0",
	"description": "italic font"
    },
    "textbf": {
	"prefix": "bt",
	"body": "\\textbf{$1}$0",
	"description": "bold font"
    },
    "mathrm": {
	"prefix": "mr",
	"body": "\\mathrm{$1}$0",
	"description": "math roman font"
    },
    "mathbf": {
	"prefix": "mf",
	"body": "\\mathbf{$1}$0",
	"description": "math bold font"
    },
    "mathbb": {
	"prefix": "mb",
	"body": "\\mathbb{$1}$0",
	"description": "math blackboard bold font"
    },
    "mathcal": {
	"prefix": "mc",
	"body": "\\mathcal{$1}$0",
	"description": "math caligraphic font"
    },
    "mathit": {
	"prefix": "mi",
	"body": "\\mathit{$1}$0",
	"description": "math italic font"
    },
    "mathtt": {
	"prefix": "mt",
	"body": "\\mathtt{$1}$0",
	"description": "math typewriter font"
    },
    "boldsymbol": {
	"prefix": "bs",
	"body": "\\boldsymbol{$1}$0",
	"description": "bold for symbols"
    },
    "itemize": {
	"prefix": "itemize",
	"body": "\\begin{itemize}\n\\item $1\n\\end{itemize}",
	"description": "the itemize block"
    },
    "enumerate": {
	"prefix": "enumerate",
	"body": "\\begin{enumerate}\n\\item $1\n\\end{enumerate}",
	"description": "the enumerate block"
    },
    "frame": {
	"prefix": "frame",
	"body": "\\begin{frame}{$1}\n$0\n\\end{frame}",
	"description": "the baeamer's frame"
    },
    "equation": {
	"prefix": "eq",
	"body": "\\begin{equation}\n$1\n\\end{equation}",
	"description": "the equation block"
    },
    "subequations": {
	"prefix": "seq",
	"body": "\\begin{subequations}\n\\begin{align}\n$1\n\\end{align}\n\\end{subequations}",
	"description": "the subequations block"
    },
    "figure": {
	"prefix": "figure",
	"body": "\\begin{figure}\n\\centering\n\\includegraphics[width=\\textwidth]{$1}\n\\end{figure}",
	"description": "the figure block"
    },
    "columns": {
	"prefix": "columns",
	"body": "\\begin{columns}\n\\begin{column}{0.5\\textwidth}\n\t$1\n\\end{column}\n\\end{columns}",
	"description": "the columns block"
    },
    "column": {
	"prefix": "column",
	"body": "\\begin{column}{0.5\\textwidth}\n\t$1\n\\end{column}",
	"description": "the column block"
    },
    "eqref": {
	"prefix": "er",
	"body": "\\eqref{eq:$1}",
	"description": "the eqref block"
    },
    "ref": {
	"prefix": "r",
	"body": "\\ref{$1}",
	"description": "the ref block"
    },
    "label": {
	"prefix": "el",
	"body": "\\label{eq:$1}",
	"description": "the label block for equations"
    }
}
